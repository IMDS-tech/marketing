{
  "openapi": "3.1.0",
  "info": {"title": "IMDS Marketing Platform API", "version": "0.3.0", "description": "Tenant-scoped public and internal service contracts."},
  "security": [{"bearerAuth": []}],
  "paths": {
    "/health": {"get": {"security": [], "summary": "Service liveness", "responses": {"200": {"description": "Healthy service", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}}}},
    "/v1/platform/workspace": {"get": {"summary": "Load tenant workspace", "parameters": [{"$ref": "#/components/parameters/AgencyId"}], "responses": {"200": {"description": "Workspace"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/v1/platform/agency": {"get": {"summary": "Read agency profile", "parameters": [{"$ref": "#/components/parameters/AgencyId"}], "responses": {"200": {"description": "Agency profile"}}}, "patch": {"summary": "Update agency profile", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AgencyInput"}}}}, "responses": {"200": {"description": "Updated agency"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/v1/platform/memberships": {"get": {"summary": "List agency memberships", "parameters": [{"$ref": "#/components/parameters/AgencyId"}], "responses": {"200": {"description": "Memberships"}}}},
    "/v1/platform/memberships/invite": {"post": {"summary": "Invite agency user", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["agencyId", "email"], "properties": {"agencyId": {"$ref": "#/components/schemas/Uuid"}, "email": {"type": "string", "format": "email"}, "role": {"type": "string", "enum": ["admin", "staff", "client"]}, "permissions": {"type": "array", "items": {"type": "string"}}}}}}}, "responses": {"200": {"description": "Membership"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/v1/clients": {"get": {"summary": "List clients", "parameters": [{"$ref": "#/components/parameters/AgencyId"}], "responses": {"200": {"description": "Clients"}}}, "post": {"summary": "Create client", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClientInput"}}}}, "responses": {"201": {"description": "Created client"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/v1/clients/{clientId}": {"get": {"summary": "Read client", "parameters": [{"$ref": "#/components/parameters/ClientId"}, {"$ref": "#/components/parameters/AgencyId"}], "responses": {"200": {"description": "Client"}, "404": {"$ref": "#/components/responses/NotFound"}}}, "patch": {"summary": "Update client", "parameters": [{"$ref": "#/components/parameters/ClientId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ClientInput"}}}}, "responses": {"200": {"description": "Updated client"}}}},
    "/v1/integrations/workspace": {"get": {"summary": "Load integrations and data sources", "parameters": [{"$ref": "#/components/parameters/AgencyId"}, {"name": "clientId", "in": "query", "schema": {"$ref": "#/components/schemas/Uuid"}}], "responses": {"200": {"description": "Integration workspace"}}}},
    "/v1/oauth/{provider}/start": {"post": {"summary": "Start OAuth flow", "parameters": [{"name": "provider", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Authorization URL"}, "403": {"$ref": "#/components/responses/Forbidden"}}}},
    "/v1/reports": {"get": {"summary": "List reports", "parameters": [{"$ref": "#/components/parameters/AgencyId"}], "responses": {"200": {"description": "Reports"}}}, "post": {"summary": "Create report", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReportInput"}}}}, "responses": {"201": {"description": "Created report"}}}},
    "/v1/analytics/campaigns": {"get": {"summary": "Campaign metrics", "parameters": [{"$ref": "#/components/parameters/AgencyId"}, {"name": "clientId", "in": "query", "required": true, "schema": {"$ref": "#/components/schemas/Uuid"}}, {"name": "dateFrom", "in": "query", "required": true, "schema": {"type": "string", "format": "date"}}, {"name": "dateTo", "in": "query", "required": true, "schema": {"type": "string", "format": "date"}}], "responses": {"200": {"description": "Campaign analytics"}}}},
    "/internal/v1/credentials/{handle}": {"get": {"security": [{"internalServiceToken": []}], "summary": "Load ephemeral provider credential", "parameters": [{"name": "handle", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "provider", "in": "query", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Credential"}, "401": {"description": "Invalid internal token"}}}}
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}, "internalServiceToken": {"type": "http", "scheme": "bearer"}},
    "parameters": {"AgencyId": {"name": "agencyId", "in": "query", "required": true, "schema": {"$ref": "#/components/schemas/Uuid"}}, "ClientId": {"name": "clientId", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/Uuid"}}},
    "responses": {"Forbidden": {"description": "Tenant or permission denied", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "NotFound": {"description": "Resource not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}},
    "schemas": {
      "Uuid": {"type": "string", "format": "uuid"},
      "Health": {"type": "object", "required": ["ok", "service"], "properties": {"ok": {"type": "boolean"}, "service": {"type": "string"}, "version": {"type": "string"}, "commit": {"type": "string"}}},
      "Error": {"type": "object", "properties": {"error": {"type": "object", "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "requestId": {"type": "string"}, "details": {"type": "object", "additionalProperties": true}}}}},
      "AgencyInput": {"type": "object", "required": ["agencyId", "name", "timezone", "currency"], "properties": {"agencyId": {"$ref": "#/components/schemas/Uuid"}, "name": {"type": "string"}, "timezone": {"type": "string"}, "currency": {"type": "string"}, "branding": {"type": "object", "additionalProperties": true}}},
      "ClientInput": {"type": "object", "required": ["agencyId", "company"], "properties": {"agencyId": {"$ref": "#/components/schemas/Uuid"}, "company": {"type": "string"}, "status": {"type": "string", "enum": ["active", "paused", "archived"]}}},
      "ReportInput": {"type": "object", "required": ["agencyId", "name"], "properties": {"agencyId": {"$ref": "#/components/schemas/Uuid"}, "clientId": {"oneOf": [{"$ref": "#/components/schemas/Uuid"}, {"type": "null"}]}, "name": {"type": "string"}, "status": {"type": "string", "enum": ["draft", "scheduled", "sent", "failed", "archived"]}}}
    }
  }
}
