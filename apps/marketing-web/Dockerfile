FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate
COPY . .
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_PLATFORM_CORE_SERVICE_URL
ARG VITE_CLIENTS_API_URL
ARG VITE_INTEGRATION_SERVICE_URL
ARG VITE_REPORT_API_URL
ARG VITE_AI_SERVICE_URL
ARG VITE_SEARCH_INDEXER_URL
ARG VITE_ENABLE_DEMO_FALLBACK=false
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY \
    VITE_PLATFORM_CORE_SERVICE_URL=$VITE_PLATFORM_CORE_SERVICE_URL \
    VITE_CLIENTS_API_URL=$VITE_CLIENTS_API_URL \
    VITE_INTEGRATION_SERVICE_URL=$VITE_INTEGRATION_SERVICE_URL \
    VITE_REPORT_API_URL=$VITE_REPORT_API_URL \
    VITE_AI_SERVICE_URL=$VITE_AI_SERVICE_URL \
    VITE_SEARCH_INDEXER_URL=$VITE_SEARCH_INDEXER_URL \
    VITE_ENABLE_DEMO_FALLBACK=$VITE_ENABLE_DEMO_FALLBACK
RUN pnpm install --no-frozen-lockfile --ignore-scripts && pnpm --filter @imds/marketing-web build

FROM nginx:1.27-alpine
COPY apps/marketing-web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/marketing-web/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
