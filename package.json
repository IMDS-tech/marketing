{
  "name": "@imds/marketing",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm --filter @imds/marketing-web build",
    "dev": "pnpm --filter @imds/marketing-web dev",
    "deploy": "pnpm build && wrangler deploy",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset"
  },
  "devDependencies": { "wrangler": "4.118.0" }
}
