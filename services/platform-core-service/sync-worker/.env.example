# Required server-side configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
INTEGRATION_SERVICE_URL=https://integrations.internal.example.com
INTEGRATION_SERVICE_TOKEN=replace-me

# Queue worker.
WORKER_ID=sync-worker-1
WORKER_IDLE_MS=5000
METRIC_UPSERT_CHUNK_SIZE=500
WORKER_RUN_ONCE=false

# Scheduler mode: enqueue one rolling 30-day resync per connected source.
WORKER_ENQUEUE_RESYNC=false
# Optional deterministic date, otherwise current UTC database date is used.
WORKER_RESYNC_DATE=

# Legacy/local Meta snapshot settings.
META_AD_ACCOUNT_ID=1234567890
DATE_FROM=2026-08-01
DATE_TO=2026-08-04
META_GRAPH_API_VERSION=v25.0
META_PAGE_SIZE=500
META_MAX_RETRIES=5
META_USE_ACCOUNT_ATTRIBUTION_SETTING=true
META_LEAD_ACTION_TYPES=lead,onsite_conversion.lead_grouped,offsite_conversion.fb_pixel_lead,leadgen_grouped

# Local development only.
# CREDENTIAL_PROVIDER=env
# META_ACCESS_TOKEN=replace-me
# META_APP_SECRET_PROOF=optional
